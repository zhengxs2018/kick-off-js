{
  "name": "@zhengxs/shared",
  "version": "0.1.0",
  "license": "MIT",
  "author": "zhengxs2018",
  "files": [
    "dist",
    "dist-types"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist-types/index.d.ts",
    "access": "public",
    "directory": "package",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "clean:bundle": "rimraf dist dist-types package",
    "prepublishOnly": "bun run clean:bundle && bun run build && clean-publish",
    "postpublish": "bun run clean:bundle"
  },
  "devDependencies": {
    "@zhengxs/tsconfig": "workspace:^"
  }
}
