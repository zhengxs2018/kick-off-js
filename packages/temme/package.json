{
  "name": "@zhengxs/temme",
  "version": "0.1.0",
  "description": "HTML extraction DSL rewritten on a POJO execution plan with a linkedom default adapter.",
  "author": "zhengxs2018",
  "license": "MIT",
  "files": [
    "dist",
    "LICENSE",
    "LICENSE.temme"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    "./compiler": "./src/compiler/index.ts",
    "./compiler/*": "./src/compiler/*",
    "./parsers": "./src/parsers/index.ts",
    "./parsers/*": "./src/parsers/*",
    "./runtime": "./src/runtime/index.ts",
    "./runtime/*": "./src/runtime/*",
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.com",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      "./package.json": "./package.json",
      "./compiler": {
        "import": "./dist/compiler/index.js",
        "types": "./dist/compiler/index.d.ts"
      },
      "./compiler/*": {
        "import": "./dist/compiler/*",
        "types": "./dist/compiler/*"
      },
      "./parsers": {
        "import": "./dist/parsers/index.js",
        "types": "./dist/parsers/index.d.ts"
      },
      "./parsers/*": {
        "import": "./dist/parsers/*",
        "types": "./dist/parsers/*"
      },
      "./runtime": {
        "import": "./dist/runtime/index.js",
        "types": "./dist/runtime/index.d.ts"
      },
      "./runtime/*": {
        "import": "./dist/runtime/*",
        "types": "./dist/runtime/*"
      },
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    }
  },
  "scripts": {
    "preinstall": "bun run build:peggy",
    "build": "bun run build:peggy && tsc -p tsconfig.build.json",
    "build:peggy": "bun run build.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:cov": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage --reporter=junit --reporter-outfile=coverage/junit.xml",
    "bench": "bun run bench/extractor.bench.ts",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --type-aware --type-check --fix",
    "format": "oxfmt",
    "check": "tsc --noEmit -p tsconfig.build.json && knip --config ./knip.config.json",
    "clean": "rimraf node_modules && bun run clean:bundle",
    "clean:bundle": "rimraf dist package",
    "prepublishOnly": "bun run lint && bun run check && bun run build && bun x clean-publish",
    "postpublish": "rimraf package"
  },
  "dependencies": {
    "linkedom": "^0.18.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "clean-publish": "^5.2.0",
    "jsdom": "^30.0.1",
    "peggy": "^5.1.0",
    "rimraf": "^6.1.3"
  }
}
