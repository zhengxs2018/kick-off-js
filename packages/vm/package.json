{
  "name": "@zhengxs/vm",
  "version": "0.1.0",
  "description": "zhengxs - A browser sandbox based on Proxy",
  "license": "MIT",
  "author": "zhengxs2018",
  "files": [
    "dist",
    "dist-types"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist-types/index.d.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "clean:bundle": "rimraf dist dist-types package",
    "prepublishOnly": "bun run clean:bundle && bun run build && clean-publish",
    "postpublish": "bun run clean:bundle"
  },
  "dependencies": {
    "@zhengxs/shared": "workspace:^"
  },
  "devDependencies": {
    "@zhengxs/tsconfig": "workspace:^",
    "vite": "^8.0.9",
    "vite-plugin-checker": "^0.6.4",
    "vite-plugin-dts": "^3.6.0",
    "vite-plugin-externalize-deps": "^0.7.0"
  }
}
