{
  "name": "@zhengxs/mlo",
  "version": "0.1.5",
  "author": "zhengxs2018",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "dist-types"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.com",
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist-types/index.d.ts"
  },
  "scripts": {
    "serve": "cd samples/ui && pnpm dev",
    "build": "tsc --build",
    "watch": "tsc --build --watch",
    "format": "prettier src --write --log-level warn --ignore-path ../../.prettierignore",
    "clean:bundle": "rimraf dist dist-types package",
    "prepublishOnly": "pnpm clean:bundle && pnpm build && clean-publish",
    "postpublish": "pnpm clean:bundle"
  },
  "devDependencies": {
    "@zhengxs/tsconfig": "workspace:^"
  }
}
