{
  "extends": "@zhengxs/tsconfig/dom",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "tsBuildInfoFile": "./node_modules/tsconfig.tsbuildinfo",
    "jsx": "react",
    "jsxFactory": "React.createElement",
    "types": ["vite/client", "react", "react-dom"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./ui/src/*"]
    },
    "noEmit": true
  },
  "include": ["node", "ui", "client"]
}
