{
  "name": "@zhengxs/ufetch",
  "version": "0.1.2",
  "description": "zhengxs - A request toolkit",
  "license": "MIT",
  "author": "zhengxs2018",
  "files": [
    "dist",
    "dist-types"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/_shims/index.js",
    "./dist/_shims/registry.js",
    "./dist/_shims/uni.js"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./shims": {
      "types": "./dist-types/_shims/index.d.ts",
      "default": "./dist/_shims/index.js"
    },
    "./shims/*": {
      "types": "./dist-types/_shims/*.d.ts",
      "default": "./dist/_shims/*.js"
    },
    "./uni": {
      "types": "./dist-types/platform/uni.d.ts",
      "default": "./dist/platform/uni.js"
    },
    "./web": {
      "types": "./dist-types/platform/web.d.ts",
      "default": "./dist/platform/web.js"
    },
    ".": {
      "types": "./dist-types/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist-types/index.d.ts",
    "access": "public",
    "directory": "package",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "clean:bundle": "rimraf dist dist-types package",
    "prepublishOnly": "bun run clean:bundle && bun run build && clean-publish",
    "postpublish": "bun run clean:bundle"
  },
  "dependencies": {
    "@zhengxs/shared": "workspace:^"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.15",
    "@zhengxs/tsconfig": "workspace:^",
    "eventsource-parser": "^3.0.1",
    "text-decoding": "^1.0.0",
    "web-streams-polyfill": "^4.1.0"
  },
  "peerDependencies": {
    "@dcloudio/types": ">=3.0.0",
    "text-decoding": ">=1.0.0",
    "web-streams-polyfill": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@dcloudio/types": {
      "optional": true
    },
    "web-streams-polyfill": {
      "optional": true
    },
    "text-decoding": {
      "optional": true
    }
  }
}
