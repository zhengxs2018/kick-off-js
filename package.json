{
  "name": "kick-off-js",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "zhengxs2018",
  "workspaces": [
    "packages/**",
    "samples/**"
  ],
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow bun",
    "prepare": "simple-git-hooks",
    "merge": "bun run scripts/merge.ts",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --type-aware --type-check --fix",
    "format": "oxfmt"
  },
  "devDependencies": {
    "@clack/prompts": "^1.7.0",
    "@types/bun": "^1.3.14",
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.2.0",
    "clean-publish": "^5.2.0",
    "fast-glob": "^3.3.3",
    "knip": "^6.32.2",
    "lint-staged": "^17.3.0",
    "mitata": "^1.0.34",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.65.0",
    "oxlint-tsgolint": "^0.23.0",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.13.1",
    "tinybench": "^3.0.0",
    "typescript": "^7.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged --relative"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "oxfmt",
      "oxlint --type-aware --type-check --fix"
    ],
    "*.{md,mdx,json}": [
      "oxfmt"
    ]
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=26.7.0"
  },
  "packageManager": "bun@1.3.14"
}
